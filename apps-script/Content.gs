function seedFaqObject_() {
  var out = {};
  SEED_FAQ.forEach(function (f) {
    if (!out[f.categoria]) out[f.categoria] = [];
    var item = { q: f.q, a: f.a };
    if (f.tag) item.tag = f.tag;
    out[f.categoria].push(item);
  });
  return out;
}
